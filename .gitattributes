# 默认按文本处理，收敛行尾差异
* text=auto eol=lf

# Windows 上确实需要 CRLF 的
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，绝不做行尾转换
*.png binary
*.jpg binary
*.pdf binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff2 binary

# 明确按文本
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf